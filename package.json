{
  "name": "function-wars",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser/play.mjs",
    "benchmark": "vite-node scripts/benchmark.ts",
    "build:edge": "esbuild src/combat/live.ts --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=supabase/functions/fw-duel/engine.js",
    "test:online": "node tests/online/integration.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.51.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "mathjs": "^14.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
